              "pattern": "^[A-Za-z0-9._:-]{16,128}$",
              "type": "string"
            }
          },
          "required": [
            "idempotencyKey"
          ],
          "type": "object"
        },
        "name": "get_purchase_result",
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": true,
          "properties": {
            "follow_up": {
              "additionalProperties": false,
              "properties": {
                "application_ready": {
                  "type": "null"
