  "overrides": {
    "confirm_domain_register": {
      "set": {
        "_meta": {
          "securitySchemes": [
            {
              "scopes": [
                "orders:domains"
              ],
              "type": "oauth2"
            }
          ]
        },
        "annotations": {
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": false,
          "title": "Confirm domain register"
        },
        "description": "Confirm a quoted domain registration and pay from the VPSNet account. Domain payments are non-refundable once confirmed and the domain action is queued only after payment succeeds. Requires the same idempotencyKey and quoteToken from quote_domain_register.",
        "execution": {
          "taskSupport": "forbidden"
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "properties": {
            "acknowledge_charge": {
              "const": true,
              "type": "boolean"
            },
            "acknowledge_non_refundable": {
              "const": true,
              "description": "The customer explicitly accepted the domain registration’s non-refundable terms.",
              "type": "boolean"
            },
            "admin_contact_id": {
              "description": "Admin contact ID used in quote",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "billing_contact_id": {
              "description": "Billing contact ID used in quote",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "domain": {
              "description": "Domain to register, exactly as quoted",
              "type": "string"
            },
            "expected_total_eur": {
              "description": "Exact final total_amount_eur including VAT from the quote, shown to and approved by the customer.",
              "minimum": 0,
              "type": "number"
            },
            "idempotencyKey": {
              "description": "Stable 16–128 character key for this exact purchase; reuse it for quote, confirmation and get_purchase_result.",
              "pattern": "^[A-Za-z0-9._:-]{16,128}$",
              "type": "string"
            },
            "nameservers": {
              "description": "Nameserver hostnames used in quote",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "payment": {
              "additionalProperties": false,
              "default": {
                "cancelUrl": "",
                "payment": 1,
                "successUrl": ""
              },
              "properties": {
                "cancelUrl": {
                  "const": "",
                  "type": "string"
                },
                "payment": {
                  "const": 1,
                  "type": "number"
                },
                "successUrl": {
                  "const": "",
                  "type": "string"
                }
              },
              "required": [
                "payment",
                "successUrl",
                "cancelUrl"
              ],
              "type": "object"
            },
            "quoteToken": {
              "description": "quoteToken returned by quote_domain_register",
              "minLength": 32,
              "type": "string"
            },
            "registrant_contact_id": {
              "description": "Registrant contact ID used in quote",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "tech_contact_id": {
              "description": "Technical contact ID used in quote",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "whois_privacy": {
              "description": "Hide public WHOIS contact details where supported. Defaults to the TLD setting.",
              "type": "boolean"
            },
            "years": {
              "description": "Registration period in years, exactly as quoted",
              "type": "number"
            }
          },
          "required": [
            "domain",
            "idempotencyKey",
            "quoteToken",
            "expected_total_eur",
            "acknowledge_charge",
            "acknowledge_non_refundable"
          ],
          "type": "object"
        },
        "name": "confirm_domain_register",
        "securitySchemes": [
          {
            "scopes": [
              "orders:domains"
            ],
            "type": "oauth2"
          }
        ],
        "title": "Confirm domain register"
      }
    },
    "confirm_service_order": {
      "set": {
        "_meta": {
          "securitySchemes": [
            {
              "scopes": [
                "orders:servers"
              ],
              "type": "oauth2"
            }
          ]
        },
        "annotations": {
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false,
          "readOnlyHint": false,
          "title": "Confirm service order"
        },
        "description": "Purchase the exact previously quoted server from VPSnet balance after explicit customer approval of its final EUR total and billing period. Supply the unchanged quote configuration, token and key. Never automatically create a new key after an uncertain result: inspect get_purchase_result. A receipt is not a ready server. Poll get_purchase_result for the financial outcome; get_service for the returned orderno additionally requires services:read. Follow follow_up for provisioning checks, permission requirements and bounded progress updates. The suggested 10-second polling interval is not an ETA. This connection receives access to its newly ordered server only within the permissions the customer granted.",
        "execution": {
          "taskSupport": "forbidden"
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "properties": {
            "acknowledge_charge": {
              "const": true,
              "description": "The customer explicitly approved this exact balance charge.",
              "type": "boolean"
            },
            "expected_total_eur": {
              "description": "Exact final amount_eur from the quote, shown to and approved by the customer.",
              "minimum": 0,
              "type": "number"
            },
            "idempotencyKey": {
              "description": "Stable key for this exact purchase; reuse it for the quote, confirmation and status.",
              "pattern": "^[A-Za-z0-9._:-]{16,128}$",
              "type": "string"
            },
            "os": {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            "period": {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            "plan": {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            "privateNetworkId": {
              "format": "uuid",
              "type": "string"
            },
            "quoteToken": {
              "maxLength": 256,
              "minLength": 32,
              "type": "string"
            },
            "resources": {
              "items": {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "rootPassword": {
              "description": "Only when the selected OS requires a password; prefer an existing SSH key for Linux.",
              "maxLength": 40,
              "minLength": 6,
              "type": "string"
            },
            "sshKey": {
              "description": "Existing public SSH key ID; mutually exclusive with rootPassword.",
              "exclusiveMinimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "plan",
            "idempotencyKey",
            "quoteToken",
            "expected_total_eur",
            "acknowledge_charge"
          ],
          "type": "object"
        },
        "name": "confirm_service_order",
        "outputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": true,
          "properties": {
            "follow_up": {
              "additionalProperties": false,
              "properties": {
                "application_ready": {
                  "type": "null"
                },
                "background_notification": {
                  "const": false,
                  "type": "boolean"
                },
                "do_not_reorder": {
                  "const": true,
                  "type": "boolean"
                },
                "guest_agent_available": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "idempotency_key": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z0-9._:-]{16,128}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max_checks_before_update": {
                  "const": 6,
                  "type": "number"
                },
                "message": {
                  "type": "string"
                },
                "next_check": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "arguments": {
                          "additionalProperties": false,
                          "properties": {
                            "idempotencyKey": {
                              "$ref": "#/properties/follow_up/properties/idempotency_key/anyOf/0"
                            },
                            "orderNo": {
                              "$ref": "#/properties/follow_up/properties/order_no/anyOf/0"
                            }
                          },
                          "type": "object"
                        },
                        "tool": {
                          "enum": [
                            "get_service",
                            "get_purchase_result"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "tool",
                        "arguments"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "order_no": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z0-9-]{1,64}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "permission_required": {
                  "anyOf": [
                    {
                      "const": "services:read",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "poll_after_seconds": {
                  "anyOf": [
                    {
                      "const": 10,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "provisioning_state": {
                  "enum": [
                    "pending",
                    "complete",
                    "not_running",
                    "needs_attention",
                    "failed",
                    "unknown"
                  ],
                  "type": "string"
                },
                "purchase_state": {
                  "anyOf": [
                    {
                      "enum": [
                        "accepted",
                        "pending",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "server_running": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "purchase_state",
                "provisioning_state",
                "permission_required",
                "order_no",
                "idempotency_key",
                "next_check",
                "poll_after_seconds",
                "max_checks_before_update",
                "do_not_reorder",
                "background_notification",
                "server_running",
                "guest_agent_available",
                "application_ready",
                "message"
              ],
              "type": "object"
            }
          },
          "type": "object"
        },
        "securitySchemes": [
          {
            "scopes": [
              "orders:servers"
            ],
            "type": "oauth2"
          }
        ],
        "title": "Confirm service order"
      }
    },
