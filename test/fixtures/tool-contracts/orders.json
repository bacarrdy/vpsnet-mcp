                    "boolean",
                    "null"
                  ]
                },
                "idempotency_key": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z0-9._:-]{16,128}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
