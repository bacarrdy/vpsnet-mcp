# The remote process must not have VPSNET_API_KEY or customer sidecar keys.
VPSNET_API_URL=https://api.vpsnet.com
VPSNET_MCP_RESOURCE=https://mcp.vpsnet.com/mcp
VPSNET_MCP_ISSUER=https://api.vpsnet.com/oauth/mcp
PORT=3100
# Server-to-server clients do not send Origin. Add exact HTTPS browser origins only as required.
VPSNET_MCP_ALLOWED_ORIGINS=
