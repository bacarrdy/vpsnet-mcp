{
  "name": "vpsnet-mcp",
  "version": "2.3.13",
  "type": "module",
  "description": "MCP server for managing VPSnet.com services, applications, DNS, domains, billing, and server lifecycle operations",
  "bin": {
    "vpsnet-mcp": "./build/index.js",
    "vpsnet-mcp-http": "./build/remote.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "docs:tools": "npm run build && node scripts/generate-tool-reference.mjs",
    "docs:tools:check": "npm run build && node scripts/generate-tool-reference.mjs --check",
    "prepublishOnly": "npm run build",
    "start:http": "node build/remote.js"
  },
  "files": [
    "build/api-configuration.js",
    "build/api.js",
    "build/application-contract.js",
    "build/auth-failure.js",
    "build/certificate-contract.js",
    "build/custom-project-contract.js",
    "build/file-restore-contract.js",
    "build/index.js",
    "build/service-rescue-contract.js",
    "build/temp-vm-contract.js",
    "build/api-path.js",
    "build/tool-result.js",
    "build/tool-schema.js",
    "build/networking-tools.js",
    "build/remote.js",
    "build/http-server.js",
    "build/request-context.js",
    "build/remote-policy.js",
    "build/remote-auth-error.js",
    "build/remote-tools.js",
    "build/remote-orders.js"
  ],
  "repository": "github:bacarrdy/vpsnet-mcp",
  "homepage": "https://github.com/bacarrdy/vpsnet-mcp",
  "author": "bacarrdy",
  "license": "MIT",
  "keywords": [
    "mcp",
    "vps",
    "dns",
    "domains",
    "vpsnet",
    "model-context-protocol",
    "claude",
    "server-management",
    "hosting",
    "managed-applications",
    "docker-applications",
    "domain-registration"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}
