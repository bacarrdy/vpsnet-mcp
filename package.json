{
  "name": "vpsnet-mcp",
  "version": "2.1.1",
  "type": "module",
  "description": "MCP server for managing VPSnet.com services, applications, DNS, domains, billing, and server lifecycle operations",
  "bin": {
    "vpsnet-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "build/api-configuration.js",
    "build/api.js",
    "build/application-contract.js",
    "build/auth-failure.js",
    "build/certificate-contract.js",
    "build/custom-project-contract.js",
    "build/file-restore-contract.js",
    "build/index.js",
    "build/service-rescue-contract.js",
    "build/temp-vm-contract.js",
    "build/api-path.js",
    "build/tool-result.js"
  ],
  "repository": "github:bacarrdy/vpsnet-mcp",
  "homepage": "https://github.com/bacarrdy/vpsnet-mcp",
  "author": "bacarrdy",
  "license": "MIT",
  "keywords": [
    "mcp",
    "vps",
    "dns",
    "domains",
    "vpsnet",
    "model-context-protocol",
    "claude",
    "server-management",
    "hosting",
    "managed-applications",
    "docker-applications",
    "domain-registration"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}
